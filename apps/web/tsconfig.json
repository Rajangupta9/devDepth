{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@devdepth/ui": ["../../packages/ui/index.ts"],
      "@/*": ["src/*"]
    },

    /* Linting */
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src", "../../packages/ui/**/*"]
}
