# DevDepth API Environment Configuration

# Server Settings
PORT=8080
ENV=development
JWT_SECRET=devdepth_super_secret_jwt_key_2026

# PostgreSQL Database Settings (via github.com/rajangupta9/pgkit)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/devdepth?sslmode=disable
PGHOST=localhost
PGPORT=5432
PGDATABASE=devdepth
PGUSER=postgres
PGPASSWORD=postgres
PG_MAX_CONNS=50
PG_MIN_CONNS=5

# Object Storage (AWS S3 / GCS via github.com/Rajangupta9/gopkg/pkg/objectstore)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=devdepth-public-assets
S3_PRIVATE_BUCKET=devdepth-private-submissions

# Code Runner Service Address
RUNNER_SERVICE_URL=http://localhost:8081
